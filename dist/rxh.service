# systemd unit. Install with:
#   sudo install -Dm755 target/release/rxh /usr/local/bin/rxh
#   sudo install -Dm644 dist/rxh.service /etc/systemd/system/rxh.service
#   sudo install -Dm644 rxh.toml /etc/rxh/rxh.toml
#   sudo systemctl enable --now rxh
# Manage it with `rxh status`, `rxh upstream add ...` and `systemctl reload rxh`.
#
# rxh tells systemd when it is ready and when a reload starts and ends
# (sd_notify), so `systemctl start` and `systemctl reload` return once the
# configuration runs, and a failed reload shows in `systemctl status`.
# Type=notify-reload needs systemd 253 or later; on older versions use
# Type=notify and ExecReload=/bin/kill -HUP $MAINPID instead.
#
# For socket activation, also install and enable dist/rxh.socket.

[Unit]
Description=RXH reverse proxy and load balancer
Documentation=https://github.com/LOSEARDES77/rxh
After=network-online.target
Wants=network-online.target

[Service]
Type=notify-reload
ExecStart=/usr/local/bin/rxh run --config /etc/rxh/rxh.toml
Restart=on-failure
DynamicUser=yes
ConfigurationDirectory=rxh
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
